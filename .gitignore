.venv/
__pycache__/
*.pyc
.env
node_modules/
.DS_Store
vapid_private_key.pem
push_subscriptions.json
media/

# Personal/runtime state -- not meant to be versioned or shared
memory/
automations.json
session_state.json
audit.jsonl
output/
tutor_memory/
tutor_knowledge/
tutor_docs_cache.json
.memory_backups/
.memory_backup_snapshot/

# Playwright MCP's own trace/console/page-snapshot logs -- can contain
# content from live browser sessions (WhatsApp/Slack/ChatGPT pages)
.playwright-mcp/

# Stray local test artifacts
test.mp3

# Output redirected here when Neural restarts its own uvicorn process
# from inside a live turn (e.g. after editing its own backend code) --
# just that run's console output, not something to version.
*.log
*.err

# Separate personal project Neural has built inside this folder (its own
# app, with its own nested git repo) -- not part of Neural itself.
projects/

# Playwright page snapshots dumped into the root by browser tools
snapshot-*.yml

# Local backup copies of edited files
*.bak
*.bak-*

# Piper voice models (downloaded on first start, ~60 MB each)
voices/

# Claude Code's per-machine settings
.claude/settings.local.json
