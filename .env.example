ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ElevenLabs is off by default -- set to true once your ElevenLabs
# account/billing is sorted. It's a middle-tier fallback now, behind
# edge-tts below.
ELEVENLABS_TTS_ENABLED=false

# edge-tts: free neural voices, on by default -- this is the primary
# voice. Pick one by listening (see backend/config.py for how to preview
# voices with the edge-tts CLI) and put its name here.
EDGE_TTS_ENABLED=true
EDGE_TTS_VOICE=en-US-AvaNeural

WAKE_PHRASE=Wake up
ANTHROPIC_MODEL=

# Cheap tier for background/non-agentic tasks only (see backend/utility.py).
# Not used for the main chat loop.
UTILITY_MODEL=claude-haiku-4-5-20251001

PERMISSION_MODE=bypassPermissions

# Browser automation (Playwright MCP) — on by default, needs Node.js/npx
# installed on this machine.
BROWSER_SKILL_ENABLED=true

# Gmail/Calendar via Google's first-party remote MCP gateway. Leave blank
# until you've done the Google Cloud Console setup in backend/google_auth.py's
# docstring — the integration stays off until GOOGLE_REFRESH_TOKEN is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional: contact address embedded in the Web Push VAPID JWT (push.py
# generates the actual keypair itself, no key to paste here).
VAPID_CONTACT_EMAIL=mailto:neural@localhost

# Buffer (social posting -- LinkedIn/Instagram/X/Facebook/Threads/TikTok/YouTube/Pinterest). Personal API key from
# https://publish.buffer.com/settings/api -- see the README for the
# one-time Buffer signup/connect-channels steps.
BUFFER_API_KEY=

# The public HTTPS origin this server is reachable at (a tunnel), only
# needed if you'll post images/video via Buffer. See the README.
PUBLIC_BASE_URL=

# Job search (JSearch on RapidAPI) -- on-demand real job listings.
# Sign up free at rapidapi.com, subscribe to the JSearch API's free
# plan, then paste the X-RapidAPI-Key it gives you here. Leave blank
# to keep the feature off. See the README's "Job search (JSearch)"
# section for the exact steps.
JSEARCH_API_KEY=

# Video editing (mcp-video, npx-launched) -- off by default since it's a
# small/new project, not an established one like Playwright. Set to true
# once you've confirmed `npx -y @studiomeyer/mcp-video` works on this machine.
VIDEO_EDITOR_ENABLED=false

