ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ElevenLabs is off by default -- set to true once your ElevenLabs
# account/billing is sorted. It's a middle-tier fallback now, behind
# edge-tts below.
ELEVENLABS_TTS_ENABLED=false

# edge-tts: free neural voices, on by default -- this is the primary
# voice. Pick one by listening (see backend/config.py for how to preview
# voices with the edge-tts CLI) and put its name here.
EDGE_TTS_ENABLED=true
EDGE_TTS_VOICE=en-US-AvaNeural

WAKE_PHRASE=Wake up
ANTHROPIC_MODEL=

# Cheap tier for background/non-agentic tasks only (see backend/utility.py).
# Not used for the main chat loop.
UTILITY_MODEL=claude-haiku-4-5-20251001

PERMISSION_MODE=bypassPermissions

# Browser automation (Playwright MCP) — on by default, needs Node.js/npx
# installed on this machine.
BROWSER_SKILL_ENABLED=true

# Gmail/Calendar via Google's first-party remote MCP gateway. Leave blank
# until you've done the Google Cloud Console setup in backend/google_auth.py's
# docstring — the integration stays off until GOOGLE_REFRESH_TOKEN is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Contact address embedded in the Web Push VAPID JWT (push.py generates
# the actual keypair itself, no key to paste here). MUST be a real
# mailto: address or a real https:// URL -- Apple's push service
# (web.push.apple.com) validates this strictly and rejects reserved/
# placeholder domains (@localhost, @example.com, .invalid, .test) with a
# 403 "BadJwtToken", even though Google's FCM accepts them fine. That
# mismatch is exactly what makes this bug so easy to miss: push looks
# like it's working (desktop/Android succeed) while iOS silently fails.
# Use your own real email here.
VAPID_CONTACT_EMAIL=mailto:you@example.com

# Buffer (social posting -- LinkedIn/Instagram/X/Facebook/Threads/TikTok/YouTube/Pinterest). Personal API key from
# https://publish.buffer.com/settings/api -- see the README for the
# one-time Buffer signup/connect-channels steps.
BUFFER_API_KEY=

# The public HTTPS origin this server is reachable at (a tunnel), only
# needed if you'll post images/video via Buffer. See the README.
PUBLIC_BASE_URL=

# Job search (JSearch on RapidAPI) -- on-demand real job listings.
# Sign up free (instant, no card) at developer.adzuna.com, which gives
# you an app_id and app_key right away -- paste both here. Leave either
# blank to keep the feature off. See the README's "Job search (Adzuna)"
# section for the exact steps, including which countries it covers.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Stock footage (Pexels) -- free real video clips for content creation,
# used instead of AI video generation (Sora is discontinued, Google
# Veo/Gemini needs a paid plan, Kling AI's "free" credits are a one-time
# trial, not ongoing -- see backend/stock_footage.py). Sign up free
# (instant, no card) at pexels.com/api for a key. Leave blank to keep
# the feature off.
PEXELS_API_KEY=

# Video editing (mcp-video, npx-launched) -- off by default since it's a
# small/new project, not an established one like Playwright. Set to true
# once you've confirmed `npx -y @studiomeyer/mcp-video` works on this machine.
VIDEO_EDITOR_ENABLED=false

# Technical Tutor mode -- how many days a cached, summarized doc page is
# trusted before the next question about it re-fetches (see
# backend/docs_cache.py). No API key needed for Tutor mode at all: the
# docs cache and session memory layers use what's already configured
# above, and the knowledge base layer runs a fully local embedding model
# (see backend/knowledge_base.py -- needs `pip install fastembed pypdf
# numpy`, no key). Leave this at its default unless you want doc pages
# refreshed more or less often.
TUTOR_DOCS_CACHE_DAYS=14
